    GROUP BY

        fs.date_key,

        fs.channel_key,

        fs.campaign_key,

        dc.region

),

--------------------------------------------------
-- MARKETING SUMMARY
--------------------------------------------------

marketing_summary AS (

    SELECT

        date_key,

        channel_key,

        campaign_key,

        --------------------------------------------------
        -- MARKETING FACTS
        --------------------------------------------------

        SUM(ad_spend)
            AS total_ad_spend,

        SUM(

            CASE

                WHEN LOWER(campaign_objective)
                    = 'acquisition'

                THEN ad_spend

                ELSE 0

            END

        ) AS acquisition_cost

    FROM `project-004c9430-f8fa-4b9a-861`.`ecommerce_data`.`fact_marketing`

    GROUP BY

        date_key,

        channel_key,

        campaign_key

)

--------------------------------------------------
-- FINAL TABLE
--------------------------------------------------

SELECT

