    create or replace table `project-004c9430-f8fa-4b9a-861`.`ecommerce_data`.`agg_customer_segment`
      
    
    

    OPTIONS()
    as (
      

--------------------------------------------------
-- CUSTOMER MONTHLY SUMMARY
--------------------------------------------------

WITH customer_summary AS (

    SELECT

        --------------------------------------------------
        -- REPORTING PERIOD
        --------------------------------------------------

        DATE_TRUNC(fs.date_key, MONTH)
            AS report_month,

        --------------------------------------------------
        -- CUSTOMER
        --------------------------------------------------

        dc.customer_key,

        dc.region,

        dc.gender,

        dc.age_band,

        dc.customer_status,

        --------------------------------------------------
        -- LIFETIME / MONTHLY METRICS
        --------------------------------------------------

        COUNT(DISTINCT fs.order_id)
            AS total_orders,

        SUM(fs.net_sales)
            AS total_revenue

    FROM `project-004c9430-f8fa-4b9a-861`.`ecommerce_data`.`fact_sales` fs

    INNER JOIN `project-004c9430-f8fa-4b9a-861`.`ecommerce_data`.`dim_customers` dc

        ON fs.customer_key = dc.customer_key

    GROUP BY

        report_month,

        dc.customer_key,

        dc.region,

        dc.gender,

        dc.age_band,

        dc.customer_status

),

--------------------------------------------------
-- SEGMENT SUMMARY
--------------------------------------------------

segment_summary AS (

    SELECT

        --------------------------------------------------
        -- REPORTING PERIOD
        --------------------------------------------------

        report_month,

        --------------------------------------------------
        -- SEGMENT
        --------------------------------------------------

        region,

        gender,

        age_band,

        customer_status,

        --------------------------------------------------
        -- CUSTOMER COUNTS
        --------------------------------------------------

        COUNT(*) AS total_customers,

        COUNTIF(total_orders > 1)
            AS repeat_customers,

        --------------------------------------------------
        -- SALES
        --------------------------------------------------

        SUM(total_orders)
            AS total_orders,

        SUM(total_revenue)
            AS total_revenue

    FROM customer_summary

    GROUP BY

        report_month,

        region,

        gender,

        age_band,

        customer_status

)

--------------------------------------------------
-- FINAL TABLE
--------------------------------------------------

SELECT

    --------------------------------------------------
    -- REPORT MONTH
    --------------------------------------------------

    report_month,

    --------------------------------------------------
    -- CUSTOMER SEGMENT
    --------------------------------------------------

    region,

    gender,

    age_band,

    customer_status,

    --------------------------------------------------
    -- CUSTOMER COUNTS
    --------------------------------------------------

    total_customers,

    repeat_customers,

    --------------------------------------------------
    -- SALES
    --------------------------------------------------

    total_orders,

    total_revenue,

    --------------------------------------------------
    -- KPI
    --------------------------------------------------

    ROUND(

        SAFE_DIVIDE(

            repeat_customers,

            total_customers

        ) * 100,

        2

    ) AS repeat_purchase_rate,

    --------------------------------------------------
    -- AUDIT
    --------------------------------------------------

    CURRENT_TIMESTAMP()

        AS loaded_at

FROM segment_summary
    );
  
